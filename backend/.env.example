# ==============================================================================
# IndiRide Real-Time Backend Environment Configuration Example
# ==============================================================================

PROJECT_NAME=IndiRide
ENVIRONMENT=development
DEBUG=True
API_V1_STR=/api

# Security & Authentication (JWT HS256)
JWT_SECRET=b63c7b80a4f5d178e24c538e1b34ad2689c47012d4d9c73efb2512a8039c2947
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080
REFRESH_TOKEN_EXPIRE_DAYS=90

# Databases
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ride_hailing
REDIS_URL=redis://localhost:6379/0
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ride_hailing

# Real Carrier SMS Gateway (Mobile OTP)
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=YOUR_FAST2SMS_API_KEY_HERE
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_FROM_NUMBER=+1234567890
MSG91_AUTH_KEY=YOUR_MSG91_AUTH_KEY_HERE
MSG91_TEMPLATE_ID=YOUR_MSG91_TEMPLATE_ID_HERE

# Matching Engine Configuration
INITIAL_MATCHING_RADIUS_KM=2.0
INITIAL_MATCHING_DURATION_SEC=180
EXPANDED_MATCHING_RADIUS_KM=3.0
MAX_BOOKING_TIMEOUT_SEC=300
RIDER_REQUEST_EXPIRY_SEC=45

# Pricing Configuration
DEFAULT_BIKE_RATE_PER_KM=7.0
DEFAULT_BULLET_RATE_PER_KM=13.0
DEFAULT_AUTO_RATE_PER_KM=10.0
DEFAULT_CAR_RATE_PER_KM=15.0
DEFAULT_CAR_PRO_RATE_PER_KM=22.0
MIN_FARE_BIKE=25.0
MIN_FARE_BULLET=40.0
MIN_FARE_AUTO=40.0
MIN_FARE_CAR=60.0
MIN_FARE_CAR_PRO=90.0

# Third-Party Integrations
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=rzp_secret_placeholder
OSRM_ROUTING_URL=https://router.project-osrm.org
NOMINATIM_GEOCODE_URL=https://nominatim.openstreetmap.org
